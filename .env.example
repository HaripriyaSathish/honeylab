# ─── LOCAL (your PC) ───────────────────────────────────────────────
# Copy to .env.local and fill in. Use the same login as MySQL Workbench.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=honey_lab

# Admin panel login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random string used to sign the login cookie
ADMIN_SECRET=

# Neon connection string — used ONLY by `npm run copy-to-neon` (copies local MySQL → Neon).
# Do NOT name it DATABASE_URL locally, or the local site switches from MySQL to Neon.
NEON_DATABASE_URL=

# ─── RENDER (Environment tab of the Web Service) ───────────────────
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require   ← when set, the app uses PostgreSQL (Neon) instead of MySQL
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<a strong password>
# ADMIN_SECRET=<long random string>
# NODE_VERSION=22
